# Public app metadata.
NEXT_PUBLIC_APP_NAME="Founders Lab OS"

# Do not add real secrets to this file.

# --- Auth (Auth.js v5, GitHub OAuth, JWT sessions) ---
#
# Key names only. The operator enters real values through the provider UI or a
# write-only secret channel.

# Session signing key. Generate with:  openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app credentials.
# Create at: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL: <your-origin>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Canonical origin. Optional locally; required in production so OAuth callbacks
# and cookie domains resolve correctly.
# AUTH_URL=https://your-domain.example
